#!/usr/bin/env bash

##
## run a solution for a language, year, and day
## if there is a container already running, use it?
##

AOC_DRY_RUN=
AOC_ROOT="$(dirname "$0")/.."
AOC_VERBOSE=

usage() {
    local exitcode=${1:-1}

    langs=()
    # shellcheck disable=SC2312
    while IFS= read -r -d '' filename; do
        langs+=("$(basename "$(dirname "${filename}")")")
    done < <(find "${AOC_ROOT}/lang" -type f -name 'Dockerfile' -print0 | sort -z)

    echo "usage: aoc-run -l <language> [ -y <year> ] [ -d <day> ] [ -t <tag> ]"
    echo "       aoc-run [ -y <year> ] [ -d <day> ] [ -t <tag> ] <language>"
    echo ""
    echo "Runs code for a year, day, and language."
    echo ""
    echo "Options:"
    echo "* -l -- language"
    echo "* -y -- year (defaults to current year)"
    echo "* -d -- day (defaults to current day)"
    echo "* -t -- tag for language Docker image (defaults to 'latest')"
    echo "* -h -- help"
    echo "* -n -- dry run"
    echo "* -v -- verbose output"
    echo ""
    echo "<language> must be one of: " "${langs[@]}"

    exit "${exitcode}"
}

# shellcheck disable=SC1091
source "${AOC_ROOT}/bin/utils.sh"

while getopts ":d:hl:nt:vy:" opt; do
    case ${opt} in
        d) # day
            AOC_DAY=${OPTARG}
            ;;

        h) # help
            usage 0
            ;;

        l) # lang
            AOC_LANG=${OPTARG}
            ;;

        n) # dry run
            export AOC_DRY_RUN=1
            ;;

        t) # tag for lang image
            export AOC_TAG=${OPTARG}
            ;;

        v) # verbose
            export AOC_VERBOSE=1
            ;;

        y) # year
            AOC_YEAR=${OPTARG}
            ;;

        \?)
            echo "invalid option -${OPTARG}" 1>&2
            usage
            ;;
        :)
            echo "option ${OPTARG} requires an argument" 1>&2
            usage
            ;;
        *) ;;
    esac
done
shift $((OPTIND - 1))

CURRENT_YEAR=$(get_current_year)
CURRENT_DAY=$(get_current_day)

export AOC_LANG=${AOC_LANG:-$1}
export AOC_TAG=${AOC_TAG:-latest}
export AOC_YEAR=${AOC_YEAR:-${CURRENT_YEAR}}
export AOC_DAY=${AOC_DAY:-${CURRENT_DAY}}

if [[ -z "${AOC_LANG}" ]]; then
    usage
elif [[ ! -d "${AOC_ROOT}/lang/${AOC_LANG}" ]]; then
    echo "unknown language ${AOC_LANG}"
    echo "${AOC_ROOT}/lang/${AOC_LANG} not found or isn't a directory"
    usage
fi

if [[ -z "${AOC_YEAR}" ]]; then
    usage
elif ! validate_year "${AOC_YEAR}"; then
    usage
fi

if [[ -z "${AOC_DAY}" ]]; then
    usage
else
    if ! validate_day "${AOC_DAY}" "${AOC_YEAR}"; then
        usage
    fi
fi

if [[ -x "${AOC_ROOT}/lang/${AOC_LANG}/aoc-run" ]]; then
    "${AOC_ROOT}/lang/${AOC_LANG}/aoc-run" -y "${AOC_YEAR}" -d "${AOC_DAY}" -t "${AOC_TAG}"
else
    # shellcheck source=/dev/null
    [[ -r "${AOC_ROOT}/lang/${AOC_LANG}/.aocrc" ]] && source "${AOC_ROOT}/lang/${AOC_LANG}/.aocrc"

    # now that we're done comparing numbers, force day to two digits
    AOC_DAY=$(printf "%02d" "${AOC_DAY}")

    STATE=$(container_state "${AOC_YEAR}" "${AOC_LANG}")

    # shellcheck disable=SC2086
    if [[ "${STATE}" == "running" ]]; then
        container_exec "run" "${AOC_YEAR}" "${AOC_LANG}" "${AOC_DAY}" "${AOC_TAG}"
    else
        [[ -d "./years/${AOC_YEAR}/${AOC_LANG}" ]] || {
            echo "${AOC_LANG} not initialized for ${AOC_YEAR}"
            exit 1
        }

        [[ -d "./years/${AOC_YEAR}/data" ]] || {
            echo "data not downloaded for ${AOC_YEAR}"
            exit 1
        }

        container_run "run" "${AOC_YEAR}" "${AOC_LANG}" "${AOC_DAY}" "${AOC_TAG}"
    fi
fi
