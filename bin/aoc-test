#!/usr/bin/env bash

##
## run tests
##

AOC_DRY_RUN=
AOC_ROOT="$(dirname "$0")/.."
AOC_VERBOSE=

usage() {
    local exitcode=${1:-1}

    langs=()
    # shellcheck disable=SC2312
    while IFS= read -r -d '' filename; do
        langs+=("$(basename "$(dirname "${filename}")")")
    done < <(find "${AOC_ROOT}/lang" -type f -name 'Dockerfile' -print0 | sort -z)

    echo "usage: aoc-test -l <language> [ -y <year> ] [ -d <day> ] [ -t <tag> ] [ -n ] [ -v ]"
    echo "       aoc-test [ -y <year> ] [ -d <day> ] [ -t <tag> ] [ -n ] [ -v ]<language>"
    echo ""
    echo "Runs tests for a year, day, and language."
    echo ""
    echo "Options:"
    echo "* -l -- language"
    echo "* -y -- year (defaults to current year)"
    echo "* -d -- day (defaults to current day)"
    echo "* -t -- tag for language Docker image (defaults to 'latest')"
    echo "* -h -- help"
    echo "* -n -- dry run"
    echo "* -v -- verbose output"
    echo ""
    echo "<language> must be one of: " "${langs[@]}"

    exit "${exitcode}"
}

# shellcheck disable=SC1091
source "${AOC_ROOT}/bin/utils.sh"

while getopts ":d:hl:nt:vy:" opt; do
    case ${opt} in
        d) # day
            export AOC_DAY=${OPTARG}
            ;;

        h) # help
            usage 0
            ;;

        l) # lang
            export AOC_LANG=${OPTARG}
            ;;

        n) # dry run
            export AOC_DRY_RUN=1
            ;;

        t) # tag for lang image
            export AOC_TAG=${OPTARG}
            ;;

        v) # verbose
            export AOC_VERBOSE=1
            ;;

        y) # year
            export AOC_YEAR=${OPTARG}
            ;;

        \?)
            echo "invalid option -${OPTARG}" 1>&2
            usage
            ;;

        :)
            echo "option ${OPTARG} requires an argument" 1>&2
            usage
            ;;

        *) ;;
    esac
done
shift $((OPTIND - 1))

# for Linux? CURRENT_YEAR=$(date --iso-8601 | cut -d '-' -f 1)
# shellcheck disable=SC2312
CURRENT_YEAR=$(date -I | cut -d '-' -f 1)
# for Linux? CURRENT_DAY=$(date --iso-8601 | cut -d '-' -f 3)
# shellcheck disable=SC2312
CURRENT_DAY=$(date -I | cut -d '-' -f 3)

export AOC_LANG=${AOC_LANG:-$1}
export AOC_TAG=${AOC_TAG:-latest}
export AOC_YEAR=${AOC_YEAR:-${CURRENT_YEAR}}
export AOC_DAY=${AOC_DAY:-${CURRENT_DAY}}

if [[ -z "${AOC_LANG}" ]]; then
    usage
elif [[ ! -d "${AOC_ROOT}/lang/${AOC_LANG}" ]]; then
    echo "unknown language ${AOC_LANG}"
    usage
fi

if [[ -z "${AOC_YEAR}" ]]; then
    usage
elif ((AOC_YEAR < 2015 || AOC_YEAR > CURRENT_YEAR)); then
    echo "year out of range"
    usage
fi

if [[ -z "${AOC_DAY}" ]]; then
    usage
else
    # strip leading zero, if any, for proper numeric comparisons
    [[ -n "${AOC_DAY}" ]] && AOC_DAY=$((AOC_DAY + 0))

    if ((AOC_DAY < 1 || AOC_DAY > 25)); then
        echo "day out of range"
        usage
    elif ((AOC_YEAR == CURRENT_YEAR && AOC_DAY > CURRENT_DAY)); then
        echo "day ${AOC_DAY} hasn't been released yet"
        usage
    fi
fi

[[ -d "${AOC_ROOT}/years/${AOC_YEAR}/${AOC_LANG}" ]] || {
    echo "${AOC_LANG} not initialized for ${AOC_YEAR}"
    exit 1
}

[[ -d "${AOC_ROOT}/years/${AOC_YEAR}/data" ]] || {
    echo "data not downloaded for ${AOC_YEAR}"
    exit 1
}

if [[ -x "${AOC_ROOT}/lang/${AOC_LANG}/aoc-test" ]]; then
    "${AOC_ROOT}/lang/${AOC_LANG}/aoc-test" -y "${AOC_YEAR}" -d "${AOC_DAY}" -t "${AOC_TAG}"
else
    # shellcheck disable=SC1090
    [[ -r "${AOC_ROOT}/lang/${AOC_LANG}/.aocrc" ]] && source "${AOC_ROOT}/lang/${AOC_LANG}/.aocrc"

    # now that we're done comparing numbers, force day to two digits
    AOC_DAY=$(printf "%02d" "${AOC_DAY}")

    case $(container_state "${AOC_YEAR}" "${AOC_LANG}") in
        running)
            container_exec "${AOC_YEAR}" "${AOC_LANG}" "${AOC_DAY}" "${AOC_TAG}"
            ;;

        stopped)
            container_run "${AOC_YEAR}" "${AOC_LANG}" "${AOC_DAY}" "${AOC_TAG}"
            ;;

        *)
            ;;
    esac
fi
