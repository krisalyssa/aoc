#!/usr/bin/env bash

##
## start a container for a language
##

AOC_DRY_RUN=
AOC_ROOT="$(dirname "$0")/.."
AOC_VERBOSE=

usage() {
    local exitcode=${1:-1}

    langs=()
    # shellcheck disable=SC2312
    while IFS= read -r -d '' filename; do
        langs+=("$(basename "$(dirname "${filename}")")")
    done < <(find "${AOC_ROOT}/lang" -type f -name 'Dockerfile' -print0 | sort -z)

    echo "usage: aoc-start -l <language> [ -y <year> ] [ -t <tag> ] [ -d ]"
    echo "       aoc-start [ -y <year> ] [ -t <tag> ] [ -d ] <language>"
    echo ""
    echo "Starts a Docker container for the language, with data files mounted."
    echo ""
    echo "Options:"
    echo "* -l -- language"
    echo "* -y -- year (defaults to current year)"
    echo "* -t -- tag for language Docker image (defaults to 'latest')"
    echo "* -d -- detach the container (run it in the background)"
    echo "* -h -- help"
    echo "* -n -- dry run"
    echo "* -v -- verbose output"
    echo ""
    echo "<language> must be one of: " "${langs[@]}"
    echo ""
    echo "NOTE: -d does not take a value and is not used to specify a day, unlike other commands."

    exit "${exitcode}"
}

# shellcheck disable=SC1091
source "${AOC_ROOT}/bin/utils.sh"

while getopts ":dhl:nt:vy:" opt; do
    case ${opt} in
        d) # detach
            DETACH=true
            ;;

        h) # help
            usage 0
            ;;

        l) # lang
            AOC_LANG=${OPTARG}
            ;;

        n) # dry run
            export AOC_DRY_RUN=1
            ;;

        t) # tag for lang image
            export AOC_TAG=${OPTARG}
            ;;

        v) # verbose
            export AOC_VERBOSE=1
            ;;

        y) # year
            AOC_YEAR=${OPTARG}
            ;;

        \?)
            echo "invalid option -${OPTARG}" 1>&2
            usage
            ;;

        :)
            echo "option ${OPTARG} requires an argument" 1>&2
            usage
            ;;
        *) ;;
    esac
done
shift $((OPTIND - 1))

CURRENT_YEAR=$(get_current_year)

export AOC_LANG=${AOC_LANG:-$1}
export AOC_TAG=${AOC_TAG:-latest}
export AOC_YEAR=${AOC_YEAR:-${CURRENT_YEAR}}

[[ -z "${DETACH}" ]] && REMOVE=true

if [[ -z "${AOC_LANG}" ]]; then
    usage
elif [[ ! -d "${AOC_ROOT}/lang/${AOC_LANG}" ]]; then
    echo "unknown language ${AOC_LANG}"
    usage
fi

if [[ -z "${AOC_YEAR}" ]]; then
    usage
elif ! validate_year "${AOC_YEAR}"; then
    usage
fi

if [[ -x "${AOC_ROOT}/lang/${AOC_LANG}/aoc-start" ]]; then
    "${AOC_ROOT}/lang/${AOC_LANG}/aoc-start" -y "${AOC_YEAR}" -t "${AOC_TAG}" ${DETACH:+-d}
else
    # shellcheck source=/dev/null
    [[ -r "${AOC_ROOT}/lang/${AOC_LANG}/.aocrc" ]] && source "${AOC_ROOT}/lang/${AOC_LANG}/.aocrc"

    CONTAINER_NAME="aoc-${AOC_LANG}${AOC_YEAR:+-${AOC_YEAR}}"

    # shellcheck disable=SC2312
    if [[ "$(docker ps --all --format json | jq -r '.Names')" == "${CONTAINER_NAME}" ]]; then
        case $(docker ps --all --format json | jq -r --arg name "${CONTAINER_NAME}" 'select(.Names == $name) | .State') in
            running)
                # echo "container is already running"
                ;;

            exited)
                # echo "starting container"
                docker start "${CONTAINER_NAME}" > /dev/null
                ;;

            *) ;;
        esac

        # echo "attaching to container"
        docker attach "${CONTAINER_NAME}"
    else
        [[ -d "${AOC_ROOT}/years/${AOC_YEAR}/${AOC_LANG}" ]] || {
            echo "${AOC_LANG} not initialized for ${AOC_YEAR}"
            exit 1
        }

        [[ -d "${AOC_ROOT}/years/${AOC_YEAR}/data" ]] || {
            echo "data not downloaded for ${AOC_YEAR}"
            exit 1
        }

        # shellcheck disable=SC2086
        docker run \
            ${DETACH:+--detach} \
            --env AOC_LANG \
            --env AOC_TAG \
            --env AOC_YEAR \
            --interactive \
            --mount "type=bind,src=${AOC_ROOT}/years/${AOC_YEAR}/${AOC_LANG},dst=/aoc/src" \
            --mount "type=bind,src=${AOC_ROOT}/years/${AOC_YEAR}/data,dst=/aoc/data" \
            ${ADDITIONAL_MOUNTS:-} \
            --name "${CONTAINER_NAME}" \
            ${REMOVE:+--rm} \
            --tty \
            ${ADDITIONAL_FLAGS:-} \
            ghcr.io/krisalyssa/aoc/aoc-${AOC_LANG}:${AOC_TAG} \
            -c "bin/start"
    fi
fi
