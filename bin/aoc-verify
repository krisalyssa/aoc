#!/usr/bin/env bash

##
## verify solutions
## NOTE: expects jq in the path
##

AOC_DAY=
AOC_DRY_RUN=
AOC_ROOT="$(dirname "$0")/.."
AOC_VERBOSE=
AOC_YEAR=

usage() {
    local exitcode=${1:-1}

    langs=()
    # shellcheck disable=SC2312
    while IFS= read -r -d '' filename; do
        langs+=("$(basename "$(dirname "${filename}")")")
    done < <(find "${AOC_ROOT}/lang" -type f -name 'Dockerfile' -print0 | sort -z)

    echo "usage: aoc-verify -l <language> [ -y <year> ] [ -d <day> ] [ -t <tag> ] [ -n ] [ -v ]"
    echo "       aoc-verify [ -y <year> ] [ -d <day> ] [ -t <tag> ] [ -n ] [ -v ] <language>"
    echo ""
    echo "Runs code for a year, day, and language and compares it to known solutions. Useful for testing code in new languages or smoke testing changes."
    echo ""
    echo "Options:"
    echo "* -l -- language"
    echo "* -y -- year (defaults to current year) ('all' is also permitted)"
    echo "* -d -- day (defaults to current day) ('all' is also permitted)"
    echo "* -t -- tag for language Docker image (defaults to 'latest')"
    echo "* -h -- help"
    echo "* -n -- dry run"
    echo "* -v -- verbose output"
    echo ""
    echo "<language> must be one of: " "${langs[@]}"

    exit "${exitcode}"
}

# shellcheck disable=SC1091
source "${AOC_ROOT}/bin/utils.sh"

while getopts ":d:hl:nt:vy:" opt; do
    case ${opt} in
        d) # day
            export AOC_DAY=${OPTARG}
            ;;

        h) # help
            usage 0
            ;;

        l) # lang
            export AOC_LANG=${OPTARG}
            ;;

        n) # dry run
            export AOC_DRY_RUN=1
            ;;

        t) # tag for lang image
            export AOC_TAG=${OPTARG}
            ;;

        v) # verbose
            export AOC_VERBOSE=1
            ;;

        y) # year
            export AOC_YEAR=${OPTARG}
            ;;

        \?)
            echo "invalid option -${OPTARG}" 1>&2
            usage
            ;;

        :)
            echo "option ${OPTARG} requires an argument" 1>&2
            usage
            ;;

        *) ;;
    esac
done
shift $((OPTIND - 1))

CURRENT_YEAR=$(get_current_year)
CURRENT_DAY=$(get_current_day)

export AOC_LANG=${AOC_LANG:-$1}
export AOC_TAG=${AOC_TAG:-latest}
export AOC_YEAR=${AOC_YEAR:-${CURRENT_YEAR}}
# export AOC_DAY=${AOC_DAY:-${CURRENT_DAY}}

if [[ -z "${AOC_LANG}" ]]; then
    usage
elif [[ ! -d "${AOC_ROOT}/lang/${AOC_LANG}" ]]; then
    echo "unknown language ${AOC_LANG}"
    usage
fi

if [[ -z "${AOC_YEAR}" ]]; then
    usage
elif ((AOC_YEAR < 2015 || AOC_YEAR > CURRENT_YEAR)); then
    echo "year out of range"
    usage
fi

if [[ -z "${AOC_DAY}" ]]; then
    if [[ "${AOC_YEAR}" == "${CURRENT_YEAR}" ]]; then
        AOC_DAY="${CURRENT_DAY}"
    else
        AOC_DAY="all"
    fi
elif [[ "${AOC_DAY}" == "all" ]]; then
    # run for all days
    :
else
    # strip leading zero, if any, for proper numeric comparisons
    AOC_DAY=$((AOC_DAY + 0))

    if ((AOC_DAY < 1 || AOC_DAY > 25)); then
        echo "day out of range"
        usage
    elif ((AOC_YEAR == CURRENT_YEAR && AOC_DAY > CURRENT_DAY)); then
        echo "day ${AOC_DAY} hasn't been released yet"
        usage
    fi
fi

if [[ -x "${AOC_ROOT}/lang/${AOC_LANG}/aoc-verify" ]]; then
    "${AOC_ROOT}/lang/${AOC_LANG}/aoc-verify" -y "${AOC_YEAR}" -d "${AOC_DAY}" -t "${AOC_TAG}"
else
    if [[ "${AOC_YEAR}" == "all" ]]; then
        AOC_YEAR=$(seq 2015 "${CURRENT_DAY}")
    fi

    if [[ "${AOC_DAY}" == "all" ]]; then
        if [[ "${AOC_YEAR}" == "${CURRENT_YEAR}" ]]; then
            AOC_DAY=$(seq 1 "${CURRENT_DAY}")
        else
            AOC_DAY=$(seq 1 25)
        fi
    fi

    # shellcheck disable=SC1090
    [[ -r "${AOC_ROOT}/lang/${AOC_LANG}/.aocrc" ]] && source "${AOC_ROOT}/lang/${AOC_LANG}/.aocrc"

    for year in ${AOC_YEAR}; do
        [[ -d "${AOC_ROOT}/years/${year}/${AOC_LANG}" ]] || {
            echo "${AOC_LANG} not initialized for ${year}"
            exit 1
        }

        [[ -d "${AOC_ROOT}/years/${year}/data" ]] || {
            echo "data not downloaded for ${year}"
            exit 1
        }

        for day in ${AOC_DAY}; do
            # now that we're done comparing numbers, force day to two digits
            day=$(printf "%02d" "${day}")

            case $(container_state "${year}" "${AOC_LANG}") in
                running)
                    OUTPUT=$(container_exec run "${year}" "${AOC_LANG}" "${day}" "${AOC_TAG}")
                    ;;

                stopped | null)
                    OUTPUT=$(container_run "${AOC_ROOT}" run "${year}" "${AOC_LANG}" "${day}" "${AOC_TAG}")
                    ;;

                *)
                    ;;
            esac

            part_1=$(echo "${OUTPUT}" | jq -r ".day_${day}[0]")
            solution_1=$(jq -r ".day_${day}[0]" "${AOC_ROOT}/years/${year}/solutions.json")
            if [[ "${solution_1}" != "null" && "${part_1}" != "${solution_1}" ]]; then
                echo "${year}-${day} part 1: ${part_1} should be ${solution_1}"
            fi

            part_2=$(echo "${OUTPUT}" | jq -r ".day_${day}[1]")
            solution_2=$(jq -r ".day_${day}[1]" "${AOC_ROOT}/years/${year}/solutions.json")
            if [[ "${solution_2}" != "null" && "${part_2}" != "${solution_2}" ]]; then
                echo "${year}-${day} part 2: ${part_2} should be ${solution_2}"
            fi
        done
    done
fi
